# Salesforce Configuration
# Login URL - use https://login.salesforce.com for production or https://test.salesforce.com for sandbox
SF_LOGIN_URL=https://login.salesforce.com

# Salesforce credentials
SF_USERNAME=your-salesforce-username@example.com
SF_PASSWORD=your-salesforce-password
SF_SECURITY_TOKEN=your-salesforce-security-token

# OAuth 2.0 credentials from Salesforce Connected App
SF_CLIENT_ID=your-connected-app-client-id
SF_CLIENT_SECRET=your-connected-app-client-secret
